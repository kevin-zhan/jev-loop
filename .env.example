# Copy this file to .env only when you do not already have a private .env — never overwrite an
# existing credentials file. Keep the copy private (chmod 600) and put the real value in it.
# The library never parses .env by itself; if you keep the key in a file, let uv load that
# real file path explicitly:
#
#   cp .env.example .env && chmod 600 .env
#   edit .env
#   uv run --env-file .env jev-loop-doctor
#   uv run --env-file .env python examples/live-files/run.py --max-steps 8
#
# If the variable is already exported in the process environment, omit the flag and run the
# command directly (uv run jev-loop-doctor).
#
# .env is ignored by git (.gitignore); .env.example is tracked and must stay empty.
# Never put the key in a command-line flag, a run spec/task, a bundle config, an event or
# a cognition message. pi must be started from a process that already has this variable.
TYPESAFE_API_KEY=
